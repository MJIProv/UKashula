{
  "extends": "markdownlint:recommended",
  "rules": {
    "line-length": {
      "line_length": 120,
      "heading_line_length": 120,
      "headers": true,
      "code_blocks": false,
      "code_lines": false,
      "tables": false,
      "headers_only": false
    },
    "MD003": {
      "style": "consistent"
    },
    "MD004": {
      "style": "consistent"
    },
    "MD013": false,
    "no-hard-tabs": true,
    "whitespace": true
  }
}
